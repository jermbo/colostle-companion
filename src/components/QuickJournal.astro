---
// Toggled visible/hidden by JS via the Journal button
---
<div class="wf-box-dashed quick-journal" id="quick-journal" style="display: none;">
  <div class="wf-label">// quick beat</div>
  <textarea
    class="quick-journal__textarea"
    id="journal-textarea"
    placeholder="What happened? What did you feel or decide..."
    aria-label="Quick journal entry"
  ></textarea>
  <div class="quick-journal__footer">
    <button class="wf-btn wf-btn-sm" id="btn-save-journal">Save entry</button>
  </div>
</div>
