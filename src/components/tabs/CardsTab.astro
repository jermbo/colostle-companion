---
---
<section id="tab-cards" class="tab-panel" role="tabpanel" aria-label="Cards">
  <div class="tab-header">
    <span class="wf-label">Deck &amp; oracles</span>
  </div>

  <div class="cards-content">
    <div class="wf-box deck-status">
      <div class="wf-label">Deck status</div>
      <div class="deck-status__row">
        <div>
          <div class="wf-h3">38 cards remaining</div>
          <div class="wf-meta">14 flipped · 0 reshuffles</div>
        </div>
        <span class="wf-tag wf-tag-accent">The Iron Vale</span>
      </div>
    </div>

    <div class="oracle-tables">
      <div class="wf-label">Oracle tables</div>
      <div class="oracle-table-list">
        <div class="wf-box oracle-table-item">
          <div>
            <div class="wf-h3">Exploration</div>
            <div class="wf-meta">Red = organic · Black = non-organic</div>
          </div>
          <span class="wf-tag wf-tag-explore">A – 10</span>
        </div>
        <div class="wf-box oracle-table-item">
          <div>
            <div class="wf-h3">Enemy Creation</div>
            <div class="wf-meta">Triggered by J, Q, K</div>
          </div>
          <span class="wf-tag wf-tag-combat">J Q K</span>
        </div>
        <div class="wf-box oracle-table-item">
          <div>
            <div class="wf-h3">Items</div>
            <div class="wf-meta">Suit irrelevant</div>
          </div>
          <span class="wf-tag">A – K</span>
        </div>
        <div class="wf-box oracle-table-item">
          <div>
            <div class="wf-h3">Settlements</div>
            <div class="wf-meta">Suit irrelevant</div>
          </div>
          <span class="wf-tag">A – K</span>
        </div>
      </div>
    </div>

    <p class="wf-meta cards-note">Oracle text will populate once rulebook prompts are entered.</p>
  </div>
</section>
